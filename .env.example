# ==============================================================================
# COGNIPATH ENVIRONMENT CONFIGURATION (SIH 2026 - Problem SIH262070/500)
# ==============================================================================

# Database Settings
# Note: In Docker Compose, DATABASE_URL points to postgresql+asyncpg://postgres:postgres@db:5432/cognipath
# For local standalone run without Docker, default fallback is sqlite+aiosqlite:///./cognipath.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognipath
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cognipath

# Security & JWT Token
SECRET_KEY=cognipath_super_secure_jwt_secret_key_sih2026_smart_education
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API Configuration (LLM & Embeddings)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Vector Store
# If using standalone ChromaDB service, set host and port.
# If running locally, backend will automatically persist to local directory ./chroma_data
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data

# Government of India Bhashini Multilingual API (ULCA)
# Enables regional Indian language ASR (Speech-to-Text), NMT (Translation), and TTS (Text-to-Speech)
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_PIPELINE_ID=your-bhashini-pipeline-id

# Application Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
